# ============================================================
# ComplianceScan 配置
# 用法：cp .env.example .env 并填写后 npm start
# ============================================================

# --- Creem 支付（MoR，个人可用，无需海外主体）---
# 注册 https://www.creem.io → Dashboard 创建订阅产品 → 复制 API Key / Product ID
CREEM_API_KEY=your_creem_api_key_here
CREEM_PRODUCT_ID=your_product_id_here
# 测试模式：true → 走 test-api.creem.io（不扣真实款项，需用 Creem 测试 key）
CREEM_TEST_MODE=false
# Webhook 验签密钥：在 Creem Dashboard 配置 Webhook 时设置，用于 /api/webhook/creem 验签
CREEM_WEBHOOK_SECRET=your_webhook_secret_here

# --- 支付通道切换（可选）---
# creem（默认，MoR，无需海外主体）｜ paddle（MoR，无需海外主体）｜ stripe（需海外主体，大陆个人不开放）
PAYMENT_PROVIDER=creem
# 站点公开地址：用于支付 success/cancel 回跳、监控邮件「查看详情」链接
SITE_URL=https://your-domain.com

# --- 备选：Stripe（需海外主体，仅骨架）---
# Stripe 对中国大陆个人不开放，需香港/海外公司 + 港卡。dashboard.stripe.com 建订阅 Price 后填入
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# --- 备选：Paddle（MoR，无需海外主体）---
# paddle.com 注册 → 建订阅 Product/Price → 拿 API Key（Sandbox 用测试 key）
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_SANDBOX=true
# Paddle.js 前端令牌（Client-side token，可在 Paddle 后台 Developer Tools 获取）
# 仅当 PAYMENT_PROVIDER=paddle 且配置真实 key 时使用，前端据此打开 hosted checkout
PADDLE_CLIENT_TOKEN=

# --- Supabase（注册 / 扫描历史 / 订阅状态）---
# supabase.com 建项目 → Project Settings → API 获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- 扫描引擎 ---
# true  = Playwright 真浏览器扫描（需已 npm install playwright 并下载 chromium）
# false/留空 = 正则扫描（零依赖降级）
USE_PLAYWRIGHT=false

# --- 每日监控 + 邮件告警（Resend）---
# 监控需要 SUPABASE_SERVICE_KEY 已配置（服务端批量读取 monitors 表）
# 告警邮件通过 Resend 发送：resend.com 注册 → 验证发件域名 → 拿 API Key
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=ComplianceScan <onboarding@resend.dev>

# --- 定时任务保护（POST /api/cron/monitor）---
# 任意强随机串；GitHub Actions / 系统 cron 调用时需携带 Bearer 该值
CRON_SECRET=change_me_to_a_long_random_string

# --- 服务端口 ---
PORT=3000
